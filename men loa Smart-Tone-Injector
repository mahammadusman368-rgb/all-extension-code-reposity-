      { Button, id="btnGoBackFromTones", text="Go Back", backgroundColor=0xFF607D8B, textColor=0xFFFFFFFF, layout_width="wrap", layout_marginRight="10dp" },
      { Button, id="btnSelectTone", text="Select Tone", backgroundColor=0xFF009688, textColor=0xFFFFFFFF, layout_width="wrap" }
    }
  }
  local dialog = AlertDialog.Builder(ctx).setView(loadlayout(listLayout)).create()
  if service then dialog.getWindow().setType(WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY) end
  
  local adapter = ArrayAdapter(ctx, android.R.layout.simple_list_item_1, items)
  toneListView.setAdapter(adapter)
  
  toneListView.setOnItemClickListener({ onItemClick = function(parent, view, position, id)
    local selectedItem = items[position + 1]
    tempSelectedTone = selectedItem
    
    if isBuiltin then
      local toneId = ToneGenerator[selectedItem]
      if toneId then
        tempSelectedPath = nil
        selectedBuiltinId = toneId
        playBuiltinTone(toneId)
        speakText("Playing: " .. selectedItem)
      end
    else
      if paths and paths[position + 1] then
        tempSelectedPath = paths[position + 1]
        playTonePreview(tempSelectedPath)
        speakText("Playing: " .. selectedItem)
      end
    end
    
    for i = 0, toneListView.getChildCount() - 1 do
      local child = toneListView.getChildAt(i)
      if child then
        child.setBackgroundColor(0x00000000)
      end
    end
    view.setBackgroundColor(0x33009688)
  end})
  
  btnSelectTone.setOnClickListener({ onClick = function()
    if tempSelectedTone then
      if isBuiltin then
        selectedBuiltinId = ToneGenerator[tempSelectedTone]
        views.txtSelectedTonePath.setText("✅ " .. tempSelectedTone)
        currentToneType = "builtin"
        speakText(tempSelectedTone .. " select ho gayi")
      else
        if tempSelectedPath then
          selectedCustomPath = tempSelectedPath
          views.txtSelectedTonePath.setText("🎵 " .. tempSelectedTone)
          currentToneType = "custom"
          speakText(tempSelectedTone .. " select ho gayi")
        end
      end
      dialog.dismiss()
      restoreFocus()
    else
      speakText("Pehle koi tone select karein!")
    end
  end})
  
  btnGoBackFromTones.setOnClickListener({ onClick = function()
    dialog.dismiss()
    restoreFocus()
  end})
  
  dialog.show()
end

