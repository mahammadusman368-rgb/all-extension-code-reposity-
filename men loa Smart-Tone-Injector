-- Inject - Only TTS, No Alert
views.btnInject.setOnClickListener({ onClick = function(v)
  if selectedExtensionFolder == "" then 
    speakText("Pehle target select karein!") 
    return 
  end
  
  local path = currentSearchPath .. selectedExtensionFolder .. "/main.lua"
  
  if isToneAlreadyInjected(path) then
    speakText(selectedExtensionFolder .. " extension mein pehle se tone maujud hai. Pehle remove karke naya inject karein.")
    return
  end
  
  local f = io.open(path, "r") 
  local content = f:read("*all") 
  f:close()
  local wf = io.open(path, "w") 
  wf:write(content .. "\n" .. generateToneCode()) 
  wf:close()
  speakText("Mubarak ho! " .. selectedExtensionFolder .. " extension mein tone successfully lag gayi!")
end})

-- Remove - Only TTS, No Alert
views.btnRemove.setOnClickListener({ onClick = function(v)
  if selectedExtensionFolder == "" then 
    speakText("Pehle target select karein!") 
    return 
  end
  
  local path = currentSearchPath .. selectedExtensionFolder .. "/main.lua"
  local f = io.open(path, "r")
  if not f then
    speakText("File nahi mili!")
    return
  end
  
  local content = f:read("*all")
  f:close()
  
  local newContent = content:gsub("%-%-% Smart_Tone_Injector_Active_Block.-%-%-% Smart_Tone_Injector_End_Block", "")
  
  if newContent == content then
    speakText(selectedExtensionFolder .. " extension mein koi tone nahi mili")
    return
  end
  
  local wf = io.open(path, "w")
  wf:write(newContent)
  wf:close()
  speakText(selectedExtensionFolder .. " extension se tone successfully remove kar di gayi!")
end})

