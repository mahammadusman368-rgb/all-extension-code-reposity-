    mediaList.setChoiceMode(ListView.CHOICE_MODE_MULTIPLE)

    local function refreshList(focusIndex)
        fileNames, filePaths = getStorageFiles(dataType)
        totalCount = #fileNames

        pcall(function()
            listDlg.setTitle(titleText .. " (" .. totalCount .. " items)")
        end)

        dataList.clear()
