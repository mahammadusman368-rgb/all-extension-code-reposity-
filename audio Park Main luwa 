            return
        end

        local folderDlg = LuaDialog(service)
        folderDlg.setTitle("Create Folder & Move Items")

        local folderLayout = {
            LinearLayout;
            orientation = "vertical";
            padding = "20dp";
            layout_width = "match_parent";
            {
                TextView;
                text = "Naye folder ka naam likhein:";
                textSize = "15sp";
                layout_marginBottom = "8dp";
                textColor = Color.BLACK;
            };
            {
                EditText;
                id = "folderNameEdit";
                hint = "Folder Name";
                layout_width = "match_parent";
                layout_height = "wrap_content";
                layout_marginBottom = "20dp";
                singleLine = true;
            };
            {
                LinearLayout;
                orientation = "horizontal";
                layout_width = "match_parent";
                gravity = "right";
                {
                    Button;
                    id = "cancelFolderBtn";
                    text = "Cancel";
                    layout_width = "wrap_content";
                    layout_height = "wrap_content";
                    layout_marginRight = "10dp";
                };
                {
                    Button;
                    id = "saveFolderBtn";
                    text = "Save";
                    layout_width = "wrap_content";
                    layout_height = "wrap_content";
                };
            };
        }
        folderDlg.setView(loadlayout(folderLayout))

        cancelFolderBtn.onClick = function()
            folderDlg.dismiss()
            speakText("Folder creation cancel kar di gayi hai.")
        end

        saveFolderBtn.onClick = function()
            local folderName = tostring(folderNameEdit.getText())
            if folderName == "" or folderName == nil then
                speakText("Barah-e-karam folder ka naam likhein.")
                return
            end

            folderDlg.dismiss()
            
            local baseDir = Environment.getExternalStorageDirectory()
            local newFolder = File(baseDir, folderName)
            local created = false
            pcall(function()
                if not newFolder.exists() then
                    created = newFolder.mkdirs()
                else
                    created = true
                end
            end)

            if created then
                local movedCount = 0
                local firstMovedIndex = nil
                if checkedPositions then
                    for i = 0, mediaList.getCount() - 1 do
                        if checkedPositions.get(i) then
                            local idx = i + 1
                            if not firstMovedIndex or idx < firstMovedIndex then
                                firstMovedIndex = idx
                            end
                            local srcPath = filePaths[idx]
                            if srcPath then
                                pcall(function()
                                    local srcFile = File(srcPath)
                                    if srcFile.exists() then
                                        local destFile = File(newFolder, srcFile.getName())
                                        srcFile.renameTo(destFile)
                                        movedCount = movedCount + 1
                                    end
                                end)
                            end
                        end
                    end
                end
                speakText("Folder " .. folderName .. " ban gaya hai aur " .. movedCount .. " items move kar diye gaye hain.")
                refreshList(firstMovedIndex)
            else
                speakText("Folder nahi ban saka.")
            end
        end

        folderDlg.show()
    end

    -- COPY BUTTON: Copies paths and STAYS in the same category dialog
    copyPathsBtn.onClick = function()
        if totalCount == 0 then
            speakText("Is category mein koi file maujud nahi hai.")
            return
        end

        local finalPaths = {}
        local count = 1
        local checkedPositions = mediaList.getCheckedItemPositions()
        
        if checkedPositions then
            for i = 0, mediaList.getCount() - 1 do
                if checkedPositions.get(i) then
                    local idx = i + 1
                    if filePaths[idx] then
                        table.insert(finalPaths, "Path " .. count .. ": " .. filePaths[idx])
                        count = count + 1
                    end
                end
            end
        end

        if #finalPaths > 0 then
            local combinedText = table.concat(finalPaths, "\n")
            copyToClipboard(combinedText)
            speakText(#finalPaths .. " item ke paths successfully clipboard mein copy hue hain.")
            -- NOTE: listDlg.dismiss() nahi kiya taaki user usi category mein rahe
        else
            speakText("Pehle kisi item ko select to karo.")
        end
    end

    listDlg.show()
