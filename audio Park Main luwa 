            speakText("Is category mein koi file maujud nahi hai.")
            return
        end

        local checkedPositions = mediaList.getCheckedItemPositions()
        local hasChecked = false
        if checkedPositions then
            for i = 0, mediaList.getCount() - 1 do
                if checkedPositions.get(i) then
                    hasChecked = true
                    break
                end
            end
        end

        if not hasChecked then
            speakText("Pehle kisi item ko select karein.")
            return
        end

        local confirmDlg = LuaDialog(service)
        confirmDlg.setTitle("Delete Confirmation")
        
        local confirmLayout = {
            LinearLayout;
            orientation = "vertical";
            padding = "20dp";
            layout_width = "match_parent";
            {
                TextView;
                text = "Kya aap waqai select kiye gaye items ko permanently delete karna chahte hain?";
                textSize = "16sp";
                layout_marginBottom = "20dp";
                textColor = Color.BLACK;
            };
            {
                LinearLayout;
                orientation = "horizontal";
                layout_width = "match_parent";
                gravity = "right";
                {
                    Button;
                    id = "cancelDelBtn";
                    text = "Cancel";
                    layout_width = "wrap_content";
                    layout_height = "wrap_content";
                    layout_marginRight = "10dp";
                };
                {
                    Button;
                    id = "confirmDelBtn";
                    text = "Delete Confirm";
                    layout_width = "wrap_content";
                    layout_height = "wrap_content";
                };
            };
        }
        confirmDlg.setView(loadlayout(confirmLayout))

        cancelDelBtn.onClick = function()
            confirmDlg.dismiss()
            speakText("Delete operation cancel kar diya gaya hai.")
        end

        confirmDelBtn.onClick = function()
            confirmDlg.dismiss()

            if currentMediaPlayer then
                pcall(function() currentMediaPlayer.stop() currentMediaPlayer.release() currentMediaPlayer = nil end)
            end
            hideInlineVideo()

            local deletedCount = 0
            local firstDeletedIndex = nil
            if checkedPositions then
                for i = mediaList.getCount() - 1, 0, -1 do
                    if checkedPositions.get(i) then
                        local idx = i + 1
                        if not firstDeletedIndex or idx < firstDeletedIndex then
                            firstDeletedIndex = idx
                        end
                        local path = filePaths[idx]
                        if path then
                            local fObj = File(path)
                            if fObj.exists() then
                                if deleteRecursive(fObj) then
                                    deletedCount = deletedCount + 1
                                end
                            end
                        end
                    end
                end
            end

            speakText(deletedCount .. " items permanently delete kar diye gaye hain.")
            refreshList(firstDeletedIndex)
        end

        confirmDlg.show()
    end

    createFolderBtn.onClick = function()
