    local function showInlineVideo(path)
        pcall(function()
            local density = service.getResources().getDisplayMetrics().density
            local params = videoPreviewContainer.getLayoutParams()
            params.height = math.floor(220 * density)
            videoPreviewContainer.setLayoutParams(params)
            videoPreviewContainer.setVisibility(View.VISIBLE)
            inlineVideoView.setVideoPath(path)
            inlineVideoView.requestFocus()
            inlineVideoView.start()
        end)
    end

    local function hideInlineVideo()
        pcall(function()
            inlineVideoView.stopPlayback()
        end)
        pcall(function()
            local params = videoPreviewContainer.getLayoutParams()
            params.height = 0
            videoPreviewContainer.setLayoutParams(params)
            videoPreviewContainer.setVisibility(View.GONE)
        end)
    end

