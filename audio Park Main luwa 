local Context = luajava.bindClass("android.content.Context")
local ClipData = luajava.bindClass("android.content.ClipData")
local Intent = luajava.bindClass("android.content.Intent")

local function copyToClipboard(text, msg)
    local clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE)
    local clip = ClipData.newPlainText("CopiedText", text)
    clipboard.setPrimaryClip(clip)
    if msg then
        pcall(function()
            if accessibility and accessibility.speak then
                accessibility.speak(msg)
            end
        end)
    end
end

local function speakText(msg)
    pcall(function()
        if accessibility and accessibility.speak then
            accessibility.speak(msg)
        end
    end)
end

-- Recursive delete so non-empty folders actually get deleted safely.
local function deleteRecursive(fileObj)
    local success = false
    pcall(function()
        if fileObj.isDirectory() then
            local children = fileObj.listFiles()
            if children then
                local len = 0
                pcall(function() len = #children end)
                if len and len > 0 then
                    for i = 0, len - 1 do
                        local child = children[i]
                        if child then
                            deleteRecursive(child)
                        end
                    end
                end
            end
        end
        success = fileObj.delete()
    end)
    return success
end

-- Fast & Clean File Scanner
local function getStorageFiles(fileType)
    local validExtensions = {}
    if fileType == "document" then
        validExtensions = {".pdf", ".txt", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx"}
    elseif fileType == "picture" then
        validExtensions = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
    elseif fileType == "audio" then
        validExtensions = {".mp3", ".wav", ".aac", ".m4a", ".ogg", ".flac"}
    elseif fileType == "video" then
        validExtensions = {".mp4", ".mkv", ".3gp", ".avi", ".mov"}
    end

    local fileNames = {}
    local filePaths = {}
    
    local function scanDir(dir)
        if not dir or not dir.exists() then return end
        local files = dir.listFiles()
        if files then
            local success, len = pcall(function() return #files end)
            if success and len and len > 0 then
                for i = 0, len - 1 do
                    local f = files[i]
                    if f then
                        local name = f.getName()
                        if name and not string.find(name, "^%.") then
                            local lowerName = string.lower(name)
                            local isDir = false
                            pcall(function() isDir = f.isDirectory() end)
                            
                            if fileType == "folder" then
                                if isDir then
                                    table.insert(fileNames, name)
                                    table.insert(filePaths, f.getAbsolutePath())
                                end
                            else
                                if isDir then
                                    scanDir(f)
                                else
                                    for _, ext in ipairs(validExtensions) do
                                        if string.sub(lowerName, -string.len(ext)) == ext then
                                            table.insert(fileNames, name)
                                            table.insert(filePaths, f.getAbsolutePath())
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    local root = Environment.getExternalStorageDirectory()
    scanDir(root)
    return fileNames, filePaths
end

