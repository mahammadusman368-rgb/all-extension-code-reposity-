        else
            for i = 1, #fileNames do
                dataList.add(fileNames[i])
            end
        end
        adapter.notifyDataSetChanged()

        if totalCount > 0 and focusIndex then
            local newIndex = focusIndex
            if newIndex > totalCount then newIndex = totalCount end
            if newIndex < 1 then newIndex = 1 end
            local zeroBased = newIndex - 1
            pcall(function()
                mediaList.setSelection(zeroBased)
                mediaList.requestFocus()
            end)
            speakText(fileNames[newIndex] .. " par focus hai")
        end
    end

    local currentMediaPlayer = nil

    mediaList.onItemClick = function(parent, view, position, id)
        if totalCount == 0 then
            mediaList.setItemChecked(position, false)
            speakText("Is category mein koi file maujud nahi hai.")
            return
        end

        local idx = position + 1
        local isChecked = mediaList.isItemChecked(position)

        if dataType == "audio" then
            if isChecked then
                speakText(fileNames[idx] .. " selected, audio play ho rahi hai")
                pcall(function()
                    if currentMediaPlayer then
                        currentMediaPlayer.stop()
                        currentMediaPlayer.release()
                        currentMediaPlayer = nil
                    end
                    currentMediaPlayer = MediaPlayer()
                    currentMediaPlayer.setDataSource(filePaths[idx])
                    currentMediaPlayer.prepare()
                    currentMediaPlayer.start()
                end)
            else
                speakText(fileNames[idx] .. " unselected, audio band ho gayi")
                pcall(function()
                    if currentMediaPlayer then
                        currentMediaPlayer.stop()
                        currentMediaPlayer.release()
                        currentMediaPlayer = nil
                    end
                end)
            end
        elseif dataType == "video" then
            if isChecked then
                speakText(fileNames[idx] .. " selected, video play ho rahi hai")
                showInlineVideo(filePaths[idx])
            else
                speakText(fileNames[idx] .. " unselected, video band ho gayi")
                hideInlineVideo()
            end
        else
            if isChecked then
                speakText(fileNames[idx] .. " selected")
            else
                speakText(fileNames[idx] .. " unselected")
            end
        end
    end

