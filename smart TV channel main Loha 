local function setFocusHighlight(view, hasFocus)
    pcall(function()
        if hasFocus then
            view.setBackgroundColor(0xFF2196F3)
            view.setTextColor(0xFFFFFFFF)
            view.setScaleX(1.02)
            view.setScaleY(1.02)
        else
            view.setBackgroundColor(0xFFE0E0E0)
            view.setTextColor(0xFF000000)
            view.setScaleX(1.0)
            view.setScaleY(1.0)
        end
    end)
end

local function registerButton(button, focusId)
    if button == nil then return end
    button.focusable = true
    button.focusableInTouchMode = true
    button.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES)
    
    button.setOnFocusChangeListener(View.OnFocusChangeListener{
        onFocusChange = function(view, hasFocus)
            setFocusHighlight(view, hasFocus)
            if hasFocus then
                duckAudio()
                pcall(function()
                    view.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
                end)
            end
        end
    })
end

local function restoreFocus(button)
    if button then
        button.postDelayed(Runnable{
            run = function()
                button.requestFocus()
                button.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
            end
        }, 100)
    end
end

local function setupFocusNavigation(view)
    if view == nil then return end
    applyDuckingDelegate(view)
    if view.getChildCount then
        local function traverse(vg)
            for i = 0, vg.getChildCount() - 1 do
                local child = vg.getChildAt(i)
                if child then
                    applyDuckingDelegate(child)
                    if child.getChildCount then traverse(child) end
                end
            end
        end
        pcall(function() traverse(view) end)
    end

    view.setOnKeyListener(View.OnKeyListener{
        onKey = function(v, keyCode, event)
            if event.getAction() == KeyEvent.ACTION_DOWN then
                local currentFocus = view.findFocus()
                if currentFocus then
                    local nextFocus = nil
                    if keyCode == KeyEvent.KEYCODE_DPAD_RIGHT then
                        nextFocus = currentFocus.focusSearch(View.FOCUS_RIGHT)
                    elseif keyCode == KeyEvent.KEYCODE_DPAD_LEFT then
                        nextFocus = currentFocus.focusSearch(View.FOCUS_LEFT)
                    elseif keyCode == KeyEvent.KEYCODE_DPAD_DOWN then
                        nextFocus = currentFocus.focusSearch(View.FOCUS_DOWN)
                    elseif keyCode == KeyEvent.KEYCODE_DPAD_UP then
                        nextFocus = currentFocus.focusSearch(View.FOCUS_UP)
                    end
                    if nextFocus then
                        nextFocus.requestFocus()
                        return true
                    end
                end
            end
            return false
        end
    })
end

local currentVideoView = nil
local currentName = nil
local currentUrl = nil
local errorCheckHandler = nil
local errorCheckRunnable = nil

local function videoErrorMessage(name, extra)
    if extra == -1004 then return name .. " play nahin ho saka, link ghalat hai ya connection fail hui"
    elseif extra == -1007 then return name .. " play nahin ho saka, stream ka format sahi nahin hai"
    elseif extra == -110 then return name .. " play nahin ho saka, connection timeout ho gaya"
    elseif extra == 200 then return name .. " play nahin ho saka, server ne connection band kar diya"
    else return name .. " play nahin ho saka, wajah maloom nahin ho saki" end
end

local function playInVideoView(videoView, name, url, onStartCallback, listRef, currentIndexRef, updateUiFunc, nextBtnRef)
    currentName = name
    currentUrl = url
    incrementChannelViewCount(url)
    
    speak(name .. " play ho gaya hai")

    if errorCheckHandler and errorCheckRunnable then
        errorCheckHandler.removeCallbacks(errorCheckRunnable)
    end

    local videoMode = prefGet("video_display_mode", "ON")
    if videoView then
        if videoMode == "OFF" then
            pcall(function() videoView.setVisibility(View.GONE) end)
        else
            pcall(function() videoView.setVisibility(View.VISIBLE) end)
        end
    end

    local ok = pcall(function()
        videoView.setVideoURI(Uri.parse(url))
        videoView.setOnPreparedListener(MediaPlayer.OnPreparedListener{
            onPrepared = function(mp)
                currentMediaPlayer = mp
                pcall(function()
                    mp.setVolume(1.0, 1.0)
                    audioManager.requestAudioFocus(audioFocusChangeListener, AudioManager.STREAM_MUSIC, AudioManager.AUDIOFOCUS_GAIN)
                end)
                mp.start()
                if onStartCallback then onStartCallback(true) end
            end
        })
        videoView.setOnErrorListener(MediaPlayer.OnErrorListener{
            onError = function(mp, what, extra)
                speak(videoErrorMessage(name, extra))
                if onStartCallback then onStartCallback(false) end
                return true
            end
        })
        videoView.start()
    end)

    if listRef and currentIndexRef and updateUiFunc and nextBtnRef then
        errorCheckHandler = Handler(Looper.getMainLooper())
        errorCheckRunnable = Runnable{
            run = function()
                pcall(function()
                    if currentVideoView and not currentVideoView.isPlaying() then
                        speak("Pichla channel offline tha, agla channel play kiya ja raha hai")
                        mainHandler.postDelayed(Runnable{
                            run = function()
                                local nextIdx = (currentIndexRef() % #listRef) + 1
                                updateUiFunc(nextIdx)
                                playInVideoView(currentVideoView, listRef[nextIdx].name, listRef[nextIdx].url, function(success)
                                    if success and nextBtnRef then nextBtnRef.setText("Pause") end
                                end, listRef, currentIndexRef, updateUiFunc, nextBtnRef)
                            end
                        }, 2000)
                    end
                end)
            end
        }
        errorCheckHandler.postDelayed(errorCheckRunnable, 6000)
    end

    if not ok then 
        speak(name .. " play nahin ho saka, link sahi format mein nahin hai") 
        if onStartCallback then onStartCallback(false) end
    end
end

local function stopVideo()
    if errorCheckHandler and errorCheckRunnable then
        errorCheckHandler.removeCallbacks(errorCheckRunnable)
    end
    pcall(function()
        if currentVideoView ~= nil then
            currentVideoView.stopPlayback()
            if currentName then speak(currentName .. " band ho gaya hai") end
        end
        if audioManager then
            audioManager.abandonAudioFocus(audioFocusChangeListener)
        end
    end)
    currentVideoView = nil
    currentMediaPlayer = nil
    currentUrl = nil
    if duckTimer then mainHandler.removeCallbacks(duckTimer) end
end

