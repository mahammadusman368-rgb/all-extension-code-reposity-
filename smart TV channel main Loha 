local function detectCategory(name)
    local lower = string.lower(name)
    if string.find(lower, "news") or string.find(lower, "न्यूज") then
        return "News"
    elseif string.find(lower, "islamic") or string.find(lower, "madani") or string.find(lower, "qtv") or string.find(lower, "deen") then
        return "Islamic"
    elseif string.find(lower, "music") or string.find(lower, "sangeet") or string.find(lower, "mtv") or string.find(lower, "b4u") then
        return "Music"
    elseif string.find(lower, "sport") or string.find(lower, "cricket") or string.find(lower, "football") then
        return "Sports"
    else
        return "Entertainment"
    end
end

