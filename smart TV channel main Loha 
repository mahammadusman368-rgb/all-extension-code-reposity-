local currentMediaPlayer = nil
local duckTimer = nil
local sleepTimerHandler = nil
local sleepRunnable = nil

local function restoreAudio()
    if currentMediaPlayer then
        pcall(function() currentMediaPlayer.setVolume(1.0, 1.0) end)
    end
end

local function duckAudio()
    if currentMediaPlayer then
        pcall(function() currentMediaPlayer.setVolume(0.1, 0.1) end)
    end
    if duckTimer then mainHandler.removeCallbacks(duckTimer) end
    duckTimer = Runnable{ run = restoreAudio }
    mainHandler.postDelayed(duckTimer, 2500)
end

local audioFocusChangeListener = AudioManager.OnAudioFocusChangeListener{
    onAudioFocusChange = function(focusChange)
        if focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK then
            duckAudio()
        elseif focusChange == AudioManager.AUDIOFOCUS_GAIN then
            restoreAudio()
        elseif focusChange == AudioManager.AUDIOFOCUS_LOSS or focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT then
            if currentMediaPlayer then
                pcall(function() currentMediaPlayer.setVolume(0.0, 0.0) end)
            end
        end
    end
}

local function applyDuckingDelegate(view)
    if view == nil then return end
    pcall(function()
        view.setAccessibilityDelegate(View.AccessibilityDelegate{
            sendAccessibilityEvent = function(host, eventType)
                if eventType == 32768 or eventType == 8 or eventType == 1 or eventType == 128 then
                    duckAudio()
                end
                pcall(function()
                    host.sendAccessibilityEventUnchecked(AccessibilityEvent.obtain(eventType))
                end)
            end
        })
    end)
end

function speak(text)
    duckAudio()
    if service then
        pcall(function() 
            service.speak(text) 
        end)
    end
end

local memoryStore = { favourites = "", sleep_mins = "0", pip_mode = "ON", epg_mode = "ON", bg_audio = "OFF", video_display_mode = "ON", view_counts = "" }

local function prefGet(prefKey, fallbackValue)
    local ok, result = pcall(function()
        return service.getSharedPreferences("SmartTVChannelPrefs", 0).getString(prefKey, fallbackValue)
    end)
    if ok and result ~= nil then return result end
    return memoryStore[prefKey] or fallbackValue
end

local function prefSet(prefKey, prefValue)
    pcall(function()
        local editor = service.getSharedPreferences("SmartTVChannelPrefs", 0).edit()
        editor.putString(prefKey, prefValue)
        editor.commit()
    end)
    memoryStore[prefKey] = prefValue
end

local function getChannelViewCount(url)
    local raw = prefGet("view_counts", "")
    for u, count in string.gmatch(raw, "([^|]+)|([^:]+):") do
        if u == url then return tonumber(count) or 0 end
    end
    return 0
end

local function incrementChannelViewCount(url)
    local counts = {}
    local raw = prefGet("view_counts", "")
    for u, count in string.gmatch(raw, "([^|]+)|([^:]+):") do
        if u ~= url then counts[u] = tonumber(count) or 0 end
    end
    counts[url] = (getChannelViewCount(url) + 1)
    local parts = {}
    for u, c in pairs(counts) do table.insert(parts, u .. "|" .. c .. ":") end
    prefSet("view_counts", table.concat(parts))
end

local function sortListByViews(list)
    table.sort(list, function(a, b)
        return getChannelViewCount(a.url) > getChannelViewCount(b.url)
    end)
    return list
end

local function cancelSleepTimer()
    if sleepTimerHandler and sleepRunnable then
        sleepTimerHandler.removeCallbacks(sleepRunnable)
    end
end

local function scheduleSleepTimer(customMins)
    cancelSleepTimer()
    local minsStr = customMins or prefGet("sleep_mins", "0")
    local mins = tonumber(minsStr) or 0
    if mins > 0 then
        sleepTimerHandler = Handler(Looper.getMainLooper())
        sleepRunnable = Runnable{
            run = function()
                speak("Sleep timer poora ho gaya hai, app band ki ja rahi hai")
                pcall(function()
                    if currentVideoView ~= nil then currentVideoView.stopPlayback() end
                end)
                pcall(function() System.exit(0) end)
            end
        }
        sleepTimerHandler.postDelayed(sleepRunnable, mins * 60 * 1000)
    end
end

local function serializeFav(list)
    local parts = {}
    for i, ch in ipairs(list) do
        parts[i] = ch.name .. "||" .. ch.url .. "||" .. (ch.category or "Custom")
    end
    return table.concat(parts, "::")
end

local function loadFavourites()
    local raw = prefGet("favourites", "")
    local list = {}
    if raw ~= nil and raw ~= "" then
        local start = 1
        while true do
            local s, e = string.find(raw, "::", start, true)
            local piece
            if s == nil then piece = string.sub(raw, start) else piece = string.sub(raw, start, s - 1) end
            local sep = string.find(piece, "||", 1, true)
            if sep then
                local sep2 = string.find(piece, "||", sep + 2, true)
                local name, url, category
                if sep2 then
                    name = string.sub(piece, 1, sep - 1)
                    url = string.sub(piece, sep + 2, sep2 - 1)
                    category = string.sub(piece, sep2 + 2)
                else
                    name = string.sub(piece, 1, sep - 1)
                    url = string.sub(piece, sep + 2)
                    category = "Custom"
                end
                table.insert(list, { name = name, url = url, category = category })
            end
            if s == nil then break end
            start = e + 1
        end
    end
    return sortListByViews(list)
end

local function saveFavourites(list) prefSet("favourites", serializeFav(list)) end

local function isFavourite(url)
    local list = loadFavourites()
    for i, ch in ipairs(list) do if ch.url == url then return true end end
    return false
end

local function addFavourite(name, url, category)
    if not isFavourite(url) then
        local list = loadFavourites()
        table.insert(list, { name = name, url = url, category = category or "Custom" })
        saveFavourites(list)
        speak(name .. " favourite mein add kar diya gaya hai")
    else
        speak(name .. " pehle se favourite mein maujood hai")
    end
end

local function removeFavourite(name, url)
    local list = loadFavourites()
    local newList = {}
    local found = false
    for i, ch in ipairs(list) do
        if ch.url == url then found = true else table.insert(newList, ch) end
    end
    saveFavourites(newList)
    if found then speak(name .. " favourite se remove kar diya gaya hai") end
end

