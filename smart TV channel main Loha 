-- Auto-detect category from channel name keywords
local function detectCategory(name)
    local lower = string.lower(name)
    if string.find(lower, "news") or string.find(lower, "न्यूज") then
        return "News"
    elseif string.find(lower, "music") or string.find(lower, "sangeet") or string.find(lower, "संगीत") then
        return "Music"
    elseif string.find(lower, "sport") or string.find(lower, "खेल") or string.find(lower, "cricket") or string.find(lower, "football") then
        return "Sports"
    else
        return "Entertainment"
    end
end

