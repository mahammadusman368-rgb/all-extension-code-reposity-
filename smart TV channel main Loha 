-- List Dialog with header and proper focus persistence
showListViewDialog = function(title, list, key, onBack, onItemClickFunc, categoryDesc)
    local d = LuaDialog(service)
    d.setTitle(title)

    local env = {}
    local layout = {
        LinearLayout, orientation="vertical", padding="10dp",
        {
            TextView, id="headerText", text=(categoryDesc or ""), layout_width="fill", focusable=true, layout_marginBottom="10dp"
        },
        {
            ListView, id="lv", layout_width="fill", layout_height="0dp", layout_weight="1", focusable=true
        },
        {
            Button, id="goBackBtn", text="Go Back", layout_width="fill", layout_marginTop="10dp", focusable=true, onClick=function()
                d.dismiss()
                onBack()
            end
        }
    }
    
    local rootView = loadlayout(layout, env)
    d.setView(rootView)

    local adp = ArrayAdapter(service, android.R.layout.simple_list_item_1)
    for _, ch in ipairs(list) do adp.add(ch.name) end
    env.lv.setAdapter(adp)

    env.lv.onItemClick = function(l, v, p, id)
        d.dismiss()
        focusMemory[key] = p + 1
        onItemClickFunc(p + 1)
    end

    d.show()

    pcall(function()
        local savedIdx = focusMemory[key] or 0
        if savedIdx == 0 then
            env.headerText.requestFocus()
            env.headerText.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        else
            env.lv.setSelection(savedIdx - 1)
            env.lv.requestFocus()
            env.lv.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end
    end)
end

-- Channel Control Screen with FIXED focus management
showChannelControl = function(list, index, returnScreenKey, returnFn, autoPlay, focusTargetId)
    local ch = list[index]
    if ch == nil then return end

    local d = LuaDialog(service)

    local isFav = isFavourite(ch.url)
    local favText = isFav and "Remove From Favourite" or "Add To Favourite"

    local env = {}
    local layout = {
        LinearLayout, orientation="vertical", padding="10dp",
        {
            ScrollView, layout_width="fill", layout_height="0dp", layout_weight="1",
            {
                LinearLayout, orientation="vertical", layout_width="fill",
                {Button, id="playPauseBtn", text="Play / Pause", layout_width="fill", focusable=true, onClick=function()
                    local playing = false
                    pcall(function() playing = currentVideoView.isPlaying() end)
                    if playing then
                        pcall(function() currentVideoView.pause() end)
                        speak(ch.name .. " band ho gaya hai")
                    else
                        if currentUrl ~= ch.url then
                            playInVideoView(currentVideoView, ch.name, ch.url)
                        else
                            local ok = pcall(function() currentVideoView.start() end)
                            if ok then speak(ch.name .. " play ho gaya hai") end
                        end
                    end
                    env[focusTargetId or "playPauseBtn"].requestFocus()
                end},
                {Button, id="nextBtn", text="Next", layout_width="fill", focusable=true, onClick=function()
                    d.dismiss()
                    local newIndex = (index % #list) + 1
                    focusMemory[returnScreenKey] = newIndex - 1
                    showChannelControl(list, newIndex, returnScreenKey, returnFn, true, "nextBtn")
                end},
                {Button, id="prevBtn", text="Previous", layout_width="fill", focusable=true, onClick=function()
                    d.dismiss()
                    local newIndex = ((index - 2) % #list) + 1
                    if newIndex < 1 then newIndex = #list end
                    focusMemory[returnScreenKey] = newIndex - 1
                    showChannelControl(list, newIndex, returnScreenKey, returnFn, true, "prevBtn")
                end},
                {Button, id="volUpBtn", text="Volume Up", layout_width="fill", focusable=true, onClick=function() 
                    adjustVolume(true)
                    env[focusTargetId or "volUpBtn"].requestFocus()
                end},
                {Button, id="volDownBtn", text="Volume Down", layout_width="fill", focusable=true, onClick=function() 
                    adjustVolume(false)
                    env[focusTargetId or "volDownBtn"].requestFocus()
                end},
                {Button, id="favBtn", text=favText, layout_width="fill", focusable=true, onClick=function()
                    if isFav then 
                        removeFavourite(ch.name, ch.url) 
                    else 
                        addFavourite(ch.name, ch.url, "Custom")
                    end
                    d.dismiss()
                    showChannelControl(list, index, returnScreenKey, returnFn, autoPlay, "favBtn")
                end}
            }
        },
        {Button, id="goBackBtn", text="Go Back", layout_width="fill", layout_marginTop="10dp", focusable=true, onClick=function()
            stopVideo()
            d.dismiss()
            returnFn()
        end}
    }

    local rootView = loadlayout(layout, env)
    
    local videoView = VideoView(service)
    currentVideoView = videoView
    local params = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 600)
    rootView.addView(videoView, 0, params)

    d.setView(rootView)
    d.show()

    -- FIXED: Focus restoration immediately after show, no autoPlay interference
    if not autoPlay then
        local targetId = focusTargetId or "playPauseBtn"
        if env[targetId] then
            env[targetId].requestFocus()
            env[targetId].sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end
    end

    if autoPlay then
        playInVideoView(videoView, ch.name, ch.url)
        local targetId = focusTargetId or "playPauseBtn"
        if env[targetId] then
            env[targetId].requestFocus()
            env[targetId].sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end
    else
        currentUrl = nil
    end
end

