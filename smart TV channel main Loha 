        LinearLayout, orientation="vertical", padding="20dp",
        {
            ScrollView, layout_width="fill", layout_height="0dp", layout_weight="1",
            {
                LinearLayout, orientation="vertical", layout_width="fill",
                {TextView, text="Creator: " .. CREATOR, focusable=true},
                {TextView, text="WhatsApp: " .. WHATSAPP_NUMBER, focusable=true},
                {Button, text="Copy WhatsApp Number", layout_width="fill", focusable=true, onClick=function()
                    local ok = pcall(function()
                        local cm = service.getSystemService(Context.CLIPBOARD_SERVICE)
                        local clip = ClipData.newPlainText("WhatsApp Number", WHATSAPP_NUMBER)
                        cm.setPrimaryClip(clip)
                    end)
                    if ok then speak("WhatsApp number copy ho gaya") else speak("Copy nahin ho saka") end
                end},
                {Button, text="Contact WhatsApp", layout_width="fill", focusable=true, onClick=function()
                    d.dismiss()
                    local ok = pcall(function()
                        local intent = Intent(Intent.ACTION_VIEW)
                        intent.setData(Uri.parse("https://wa.me/" .. WHATSAPP_NUMBER))
                        service.startActivity(intent)
                    end)
                    if not ok then speak("WhatsApp open nahin ho saka") end
                end}
            }
        },
        {Button, text="Go Back", layout_width="fill", layout_marginTop="10dp", focusable=true, onClick=function() d.dismiss(); showMainMenu() end}
    }

    d.setView(loadlayout(layout))
    d.show()
end

showMainMenu = function()
    local key = "mainmenu"
    local d = LuaDialog(service)
    d.setTitle(APP_NAME .. " | Creator: " .. CREATOR)

    local env = {}
    local layout = {
        LinearLayout, orientation="vertical", padding="20dp",
        {
            ScrollView, layout_width="fill", layout_height="0dp", layout_weight="1",
            {
                LinearLayout, orientation="vertical", layout_width="fill", id="menu_container",
                {Button, text="Favourite Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 0; showFavouriteList() end},
                {Button, text="Pakistan Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 1; showCountryMenu("Pakistan") end},
                {Button, text="India Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 2; showCountryMenu("India") end},
                {Button, text="International Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 3; showCountryMenu("International") end},
                {Button, text="Sports Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 4; showSportsList() end},
                {Button, text="Add Channel", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 5; showAddChannel() end},
                {Button, text="About and Support", layout_width="fill", focusable=true, onClick=function() d.dismiss(); focusMemory[key] = 6; showAboutSupport() end}
            }
        },
        {Button, text="Go Back", layout_width="fill", layout_marginTop="10dp", focusable=true, onClick=function()
            stopVideo()
            d.dismiss()
        end}
    }

    local rootView = loadlayout(layout, env)
    d.setView(rootView)
    d.show()

    pcall(function()
        local btn = env.menu_container.getChildAt(focusMemory[key] or 0)
        if btn then 
            btn.requestFocus() 
            btn.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end
    end)
end

showMainMenu()