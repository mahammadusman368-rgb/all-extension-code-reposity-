showListViewDialog = function(title, list, key, onBack, onItemClickFunc, categoryDesc)
    local sortedList = sortListByViews(list)
    local d = LuaDialog(service)
    d.setTitle(title)

    local env = {}
    local layout = {
        LinearLayout, orientation="vertical", padding="10dp",
        {
            TextView, id="headerText", text=(categoryDesc or ""), layout_width="fill", focusable=true, layout_marginBottom="10dp"
        },
        {
            ListView, id="lv", layout_width="fill", layout_height="0dp", layout_weight="1", focusable=true
        },
        {
            Button, id="goBackBtn", text="Go Back", layout_width="fill", layout_height="55dp", layout_marginTop="10dp", focusable=true, onClick=function()
                d.dismiss()
                onBack()
            end
        }
    }
    
    local rootView = loadlayout(layout, env)
    d.setView(rootView)
    setupFocusNavigation(rootView)

    applyDuckingDelegate(env.lv)
    registerButton(env.goBackBtn, "goBackBtn")

    local adp = ArrayAdapter(service, android.R.layout.simple_list_item_1)
    for _, ch in ipairs(sortedList) do adp.add(ch.name) end
    env.lv.setAdapter(adp)

    env.lv.onItemClick = function(l, v, p, id)
        d.dismiss()
        focusMemory[key] = p + 1
        onItemClickFunc(p + 1)
    end

    env.lv.onItemSelected = function(l, v, p, id)
        duckAudio()
    end

    d.show()

    pcall(function()
        local savedIdx = focusMemory[key] or 0
        if savedIdx == 0 then
            env.headerText.requestFocus()
            env.headerText.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        else
            env.lv.setSelection(savedIdx - 1)
            env.lv.requestFocus()
            env.lv.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end
    end)
end

